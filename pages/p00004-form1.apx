page 4 (
    name: FORM2
    alias: FORM2
    title: MY FIRST TEST
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region form1 (
        name: FORM1
        type: form
        source {
            location: localDatabase
            tableName: SEC_USERS
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P4_CREATED_AT (
        type: datePicker
        label {
            label: Created At
            alignment: right
        }
        layout {
            sequence: 150
            region: @form1
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @form1
            column: CREATED_AT
            dataType: timestamp
        }
    )

    pageItem P4_CREATED_BY (
        type: numberField
        label {
            label: Created By
            alignment: right
        }
        layout {
            sequence: 160
            region: @form1
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @form1
            column: CREATED_BY
            dataType: number
        }
    )

    pageItem P4_EMAIL (
        type: textField
        label {
            label: Email
            alignment: right
        }
        layout {
            sequence: 70
            region: @form1
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 200
        }
        source {
            formRegion: @form1
            column: EMAIL
            dataType: varchar2
        }
    )

    pageItem P4_FULL_NAME (
        type: textField
        label {
            label: Full Name
            alignment: right
        }
        layout {
            sequence: 60
            region: @form1
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 200
        }
        source {
            formRegion: @form1
            column: FULL_NAME
            dataType: varchar2
        }
    )

    pageItem P4_IBS_INVOICING_NAME (
        type: textField
        label {
            label: Ibs Invoicing Name
            alignment: right
        }
        layout {
            sequence: 140
            region: @form1
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @form1
            column: IBS_INVOICING_NAME
            dataType: varchar2
        }
    )

    pageItem P4_IBS_NO (
        type: numberField
        label {
            label: Ibs No
            alignment: right
        }
        layout {
            sequence: 120
            region: @form1
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @form1
            column: IBS_NO
            dataType: number
        }
    )

    pageItem P4_IS_SUPER_ADMIN (
        type: textField
        label {
            label: Is Super Admin
            alignment: right
        }
        layout {
            sequence: 90
            region: @form1
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 1
        }
        source {
            formRegion: @form1
            column: IS_SUPER_ADMIN
            dataType: varchar2
        }
    )

    pageItem P4_LAST_LOGIN_AT (
        type: datePicker
        label {
            label: Last Login At
            alignment: right
        }
        layout {
            sequence: 110
            region: @form1
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @form1
            column: LAST_LOGIN_AT
            dataType: timestamp
        }
    )

    pageItem P4_MOBILE (
        type: textField
        label {
            label: Mobile
            alignment: right
        }
        layout {
            sequence: 80
            region: @form1
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 50
        }
        source {
            formRegion: @form1
            column: MOBILE
            dataType: varchar2
        }
    )

    pageItem P4_OS_USER (
        type: textField
        label {
            label: Os User
            alignment: right
        }
        layout {
            sequence: 130
            region: @form1
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @form1
            column: OS_USER
            dataType: varchar2
        }
    )

    pageItem P4_PASSWORD_HASH (
        type: textarea
        label {
            label: Password Hash
            alignment: right
        }
        layout {
            sequence: 50
            region: @form1
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 500
        }
        source {
            formRegion: @form1
            column: PASSWORD_HASH
            dataType: varchar2
        }
    )

    pageItem P4_PWD (
        type: textarea
        label {
            label: Pwd
            alignment: right
        }
        layout {
            sequence: 40
            region: @form1
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 4
        }
        validation {
            maxLength: 500
        }
        source {
            formRegion: @form1
            column: PWD
            dataType: varchar2
        }
    )

    pageItem P4_STATUS (
        type: textField
        label {
            label: Status
            alignment: right
        }
        layout {
            sequence: 100
            region: @form1
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 20
        }
        source {
            formRegion: @form1
            column: STATUS
            dataType: varchar2
        }
    )

    pageItem P4_UPDATED_AT (
        type: datePicker
        label {
            label: Updated At
            alignment: right
        }
        layout {
            sequence: 170
            region: @form1
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @form1
            column: UPDATED_AT
            dataType: timestamp
        }
    )

    pageItem P4_UPDATED_BY (
        type: numberField
        label {
            label: Updated By
            alignment: right
        }
        layout {
            sequence: 180
            region: @form1
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @form1
            column: UPDATED_BY
            dataType: number
        }
    )

    pageItem P4_USERNAME (
        type: textField
        label {
            label: Username
            alignment: right
        }
        layout {
            sequence: 30
            region: @form1
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @form1
            column: USERNAME
            dataType: varchar2
        }
    )

    pageItem P4_USER_ID (
        type: hidden
        layout {
            sequence: 10
            region: @form1
            slot: regionBody
        }
        source {
            formRegion: @form1
            column: USER_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P4_USER_UUID (
        type: textField
        label {
            label: User Uuid
            alignment: right
        }
        layout {
            sequence: 20
            region: @form1
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 36
        }
        source {
            formRegion: @form1
            column: USER_UUID
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @form1
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @form1
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P4_USER_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @form1
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P4_USER_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @form1
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P4_USER_ID
        }
    )

    validation p4-created-at-must-be-timestamp (
        name: P4_CREATED_AT must be timestamp
        execution {
            sequence: 140
        }
        validation {
            type: itemIsAValidTimestamp
            item: P4_CREATED_AT
        }
        error {
            errorMessage: #LABEL# must be a valid timestamp.
            associatedItem: @P4_CREATED_AT
        }
    )

    validation p4-last-login-at-must-be-timestamp (
        name: P4_LAST_LOGIN_AT must be timestamp
        execution {
            sequence: 100
        }
        validation {
            type: itemIsAValidTimestamp
            item: P4_LAST_LOGIN_AT
        }
        error {
            errorMessage: #LABEL# must be a valid timestamp.
            associatedItem: @P4_LAST_LOGIN_AT
        }
    )

    validation p4-updated-at-must-be-timestamp (
        name: P4_UPDATED_AT must be timestamp
        execution {
            sequence: 160
        }
        validation {
            type: itemIsAValidTimestamp
            item: P4_UPDATED_AT
        }
        error {
            errorMessage: #LABEL# must be a valid timestamp.
            associatedItem: @P4_UPDATED_AT
        }
    )

    process initialize-form-form1 (
        name: Initialize form FORM1
        type: formInitialization
        formRegion: @form1
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 13297935946286397
        }
    )

    process process-form-form1 (
        name: Process form FORM1
        type: formAutoRowProcessing
        formRegion: @form1
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 13298376218286398
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 1
            }
        }
    )

)
